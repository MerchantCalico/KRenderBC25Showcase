{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}+${minecraft_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_author}"
	],
	"contributors": [
		"${mod_contributors}"
	],
	"contact": {
		"homepage": "https://github.com/${sources}",
		"issues": "https://github.com/${sources}/issues",
		"sources": "https://github.com/${sources}"
	},
	"license": "${mod_license}",
	"icon": "assets/${mod_id}/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "net.merchantcalico.krendershowcase.KRenderShowcase"
		],
		"client": [
          "net.merchantcalico.krendershowcase.client.KRenderShowcaseClient"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"depends": {
		"fabricloader": "${fabric_loader_range}",
		"fabric-api": "*",
		"minecraft": "${fabric_minecraft_version_range}",
		"java": ">=${java_version}"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.github_releases": "https://github.com/${sources}/releases",
				"modmenu.kofi": "https://ko-fi.com/kneelawk"
			}
		}
	}
}